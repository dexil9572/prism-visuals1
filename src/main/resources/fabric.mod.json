{
  "schemaVersion": 1,
  "id": "prism",
  "version": "${version}",
  "name": "Prism Visuals",
  "description": "Клиентский визуальный мод: цветные частицы удара, фуллбрайт, плавный зум, кейстроки, кастомный прицел, подсветка блоков, HUD и многое другое. Right Shift — меню.",
  "authors": [
    "You"
  ],
  "license": "MIT",
  "icon": "assets/prism/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.prism.vis.PrismClient"
    ]
  },
  "mixins": [
    {
      "config": "prism.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
